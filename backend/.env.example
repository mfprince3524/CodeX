# BioMindQ Environment Configuration

ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./biomindq.db

# NCBI PubMed API Configuration (Optional API key for higher rate limits)
NCBI_API_KEY=
NCBI_EMAIL=researcher@biomindq.org
NCBI_TOOL=BioMindQ

# DrugBank API Credentials (Optional - Mock/reference adapter active when omitted)
DRUGBANK_API_KEY=
DRUGBANK_BASE_URL=https://api.drugbank.com/v1

# LLM Providers (Optional for live dynamic synthesis expansion)
OPENAI_API_KEY=
GEMINI_API_KEY=
